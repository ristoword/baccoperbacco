# Railway — variabili da impostare nel servizio (Variables)
# Volume: monta un volume su mount path /app/persist (Settings → Volumes)

NODE_ENV=production
PORT=5000

# Dashboard titolare (/admin) — generato automaticamente; copia in Railway Variables
ADMIN_USERNAME=bacco
ADMIN_PASSWORD=GENERATED_REPLACE_ME
JWT_SECRET=GENERATED_REPLACE_ME

# Opzionale se il volume non usa il path standard Railway
# PERSIST_DIR=/app/persist
