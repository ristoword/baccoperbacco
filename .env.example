# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Public URL for canonical links & sitemap (production)
# VITE_SITE_URL=https://baccoperbacco.nl

# Owner dashboard login (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bacco2026
# Or use a bcrypt hash instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=

# Required in production so sessions survive restarts
JWT_SECRET=change-this-to-a-long-random-string

# Persistent storage (Docker/Railway): mount volume at /app/persist
# PERSIST_DIR=/app/persist

# Railway: JSON data and uploads use /app/persist/data and /app/persist/uploads
# when NODE_ENV=production. Attach a volume at mount path /app/persist.
#
# Backup (JSON + uploads): npm run backup:railway  (requires Railway CLI + link)
# Restore: npm run restore:railway -- backups/bacco-railway-….tar.gz
# Schedule: e.g. weekly Task Scheduler → backup:railway, copy archives to OneDrive.
